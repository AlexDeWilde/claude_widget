{
  "manifest_version": 3,
  "name": "Claude Usage Bridge",
  "version": "1.0",
  "description": "Bridges Claude usage to desktop widget.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.claude.ai/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
